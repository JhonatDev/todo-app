# Copie este arquivo para .env apenas em ambiente local e preencha com seus valores.
# NUNCA versione o arquivo .env com credenciais reais.

# Versão das imagens locais / deploy
IMAGE_TAG=1.0.0
DOCKER_REGISTRY=ghcr.io/seu-usuario
DOCKER_TAG=1.0.0

# Frontend e Proxy Nginx
# Localmente usa 8080 porque a porta 80 pode estar ocupada; na AWS a VM expõe 80/443 via proxy TLS
FRONTEND_PORT=8080
APP_HTTP_BIND=127.0.0.1:8080
# Deixe vazio para o React usar caminho relativo (/todos) via proxy reverso do Nginx
REACT_APP_API_URL=

# Backend API
BACKEND_PORT=5000
# Em produção, informe a URL pública HTTPS (ex.: https://todo.exemplo.com) ou deixe vazio para bloquear CORS cruzado
CORS_ORIGIN=http://localhost:8080

# MongoDB (Admin + Usuário dedicado da aplicação)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MONGO_DB=todo-app
MONGO_APP_USER=todo_app_user
MONGO_APP_PASSWORD=CHANGE_ME_STRONG_APP_PASSWORD
MONGO_PORT=27017

# Endereço privado da VM de banco na AWS (usado em deploy/docker-compose.app.yml e db.yml)
MONGO_PRIVATE_IP=10.0.2.10

