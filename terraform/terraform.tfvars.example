# Copie este arquivo para terraform.tfvars apenas localmente e preencha seus valores.
# NUNCA versione arquivos *.tfvars com dados sensíveis ou chaves reais.

project_name = "todo-app"
environment  = "dev"
region       = "sa-east-1"

# Nomes opcionais das VMs (vazio utiliza padrão <project_name>-<environment>-app / -db)
app_vm_name = ""
db_vm_name  = ""

# Tipo das instâncias EC2
instance_type     = "t3.micro"
app_instance_type = ""
db_instance_type  = ""

# Deixe vazio para selecionar automaticamente a AMI oficial mais recente do Ubuntu 24.04 LTS
os_image_ami = ""
ssh_user     = "ubuntu"

# Armazenamento (GB)
root_volume_size = 20
db_volume_size   = 20

# Rede
vpc_cidr               = "10.0.0.0/16"
public_subnet_cidr     = "10.0.1.0/24"
db_subnet_cidr         = "10.0.2.0/24"
db_associate_public_ip = true

# SUBSTITUA pelo seu IP público administrativo no formato CIDR (ex.: 203.0.113.10/32)
admin_cidr = "CHANGE_ME_YOUR_PUBLIC_IP/32"

# Chave SSH: informe o conteúdo da chave pública (ex.: ~/.ssh/id_ed25519.pub)
# ou deixe ssh_public_key vazio para reutilizar um Key Pair já existente na AWS
ssh_key_name   = "todo-app-key"
ssh_public_key = ""

