environment   = "dev"
region        = "sa-east-1"
instance_type = "t3.micro"

# Resolva uma AMI oficial Ubuntu 24.04 amd64 na região e use o mesmo ID nas reexecuções.
os_image_ami = "ami-00000000000000000"

# Chave pública do par usado pelo Ansible via SSM, ou deixe vazio e reutilize ssh_key_name.
ssh_public_key = ""
ssh_key_name   = "todo-app-key"

# Campos opcionais para sobrescrever nome/tamanho de uma VM específica.
app_vm_name       = ""
db_vm_name        = ""
app_instance_type = ""
db_instance_type  = ""
db_volume_size    = 20
